# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Web demo audio — downloaded locally by scripts/fetch_demo_audio.sh for
# manual review before the user uploads it to their own hosting. Never
# committed: LibriVox audio is public domain, but there's no reason to
# carry MP3s in git history.
/demo_audio/

# Local screenshot verification artifacts (not source; goldens live in test/)
/shots/
# Store-launch-kit capture output. The harness writes to /private/tmp (see
# macos/Runner/DebugProfile.entitlements for why it is not a path under the
# home directory) and the PNGs are copied here for validation and bundling.
# Generated, large, and re-creatable from lib/screenshot_main.dart.
/store_screenshots/

# Golden-test failure artifacts. Flutter writes these next to the test on
# every failed golden comparison (master/test/diff PNGs). They are transient
# debug output, not source — the goldens themselves live in test/**/goldens/.
**/test/**/failures/
