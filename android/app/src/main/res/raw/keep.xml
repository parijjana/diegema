<?xml version="1.0" encoding="utf-8"?>
<!-- Resources looked up by name at runtime, which the release resource
     shrinker cannot see. audio_service finds the notification icon from the
     string 'drawable/ic_stat_campfire' (lib/services/diegema_audio_handler.dart);
     without this the icon is stripped and Android rejects the playback
     notification ("no valid small icon"), crashing the app. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_campfire" />
