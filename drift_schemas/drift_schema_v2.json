  "fixed_sql": [
    {
      "name": "audiobooks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"audiobooks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"author\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"source\" TEXT NOT NULL DEFAULT 'Local', \"origin\" TEXT NOT NULL DEFAULT 'local', \"cover_url\" TEXT NULL, \"user_cover_path\" TEXT NULL, \"is_downloaded\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_downloaded\" IN (0, 1)), \"is_pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_pinned\" IN (0, 1)), \"pin_order\" INTEGER NULL, \"hidden_from_continue\" INTEGER NOT NULL DEFAULT 0 CHECK (\"hidden_from_continue\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "chapters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chapters\" (\"id\" TEXT NOT NULL, \"audiobook_id\" TEXT NOT NULL, \"chapter_index\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"audio_path_or_url\" TEXT NOT NULL, \"duration_seconds\" INTEGER NOT NULL DEFAULT 0, \"is_stream\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_stream\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "playback_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playback_progress\" (\"audiobook_id\" TEXT NOT NULL, \"chapter_index\" INTEGER NOT NULL, \"position_seconds\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"audiobook_id\"));"
        }
      ]
    },
    {
      "name": "bookmarks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookmarks\" (\"id\" TEXT NOT NULL, \"audiobook_id\" TEXT NOT NULL, \"chapter_index\" INTEGER NOT NULL, \"position_seconds\" INTEGER NOT NULL, \"end_position_seconds\" INTEGER NULL, \"title\" TEXT NOT NULL DEFAULT '', \"note\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
